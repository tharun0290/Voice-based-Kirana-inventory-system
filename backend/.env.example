# NVIDIA Integrate API Key for DiffusionGemma 26B A4B IT
# Get yours from https://build.nvidia.com/google/diffusiongemma-26b-a4b-it
NVIDIA_API_KEY=your_nvidia_api_key_here

# Database Configuration (MySQL default, automatically falls back to SQLite if unreachable)
DATABASE_URL=sqlite:///./kirana_inventory.db
# Example for MySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/kirana_db

# Thinking template toggle for lower latency
ENABLE_THINKING=False
